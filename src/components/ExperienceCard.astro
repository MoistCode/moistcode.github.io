---
interface Props {
  logo: string;
  logoAlt: string;
  companyUrl: string;
  role: string;
  dates: string;
}

const { logo, logoAlt, companyUrl, role, dates } = Astro.props;
---

<div class="exp-card">
  <a href={companyUrl} target="_blank" rel="noopener">
    <img class="exp-logo" src={logo} alt={logoAlt}>
  </a>
  <div class="exp-role">{role}</div>
  <div class="exp-dates">{dates}</div>
</div>

<style>
  .exp-card {
    flex: 1 1 auto;
    background: rgba(34, 211, 238, 0.03);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color 0.2s;
    font-family: var(--font-mono);
  }
  .exp-card:hover { border-color: var(--card-hover-border); }
  .exp-logo {
    height: 28px;
    width: auto;
  }
  .exp-role {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .exp-dates {
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .exp-card { padding: 10px 14px; gap: 2px; }
    .exp-logo { height: 20px; }
    .exp-role { font-size: 12px; }
    .exp-dates { font-size: 11px; }
  }
</style>