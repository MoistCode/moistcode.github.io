---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isBlog = currentPath.startsWith('/blog');
---

<nav class="nav">
  <div class="nav-left">
    <a href="/" class="nav-home-link">
      <img class="nav-avatar-small" src="/images/avatar.png" alt="Tommy Pham" width="28" height="28">
      <div class="nav-name">
        <span class="tilde">~</span>
        <span>tommy pham</span>
      </div>
    </a>
  </div>
  <div class="nav-right">
    <a href="/" class:list={[{ active: isHome }]}>home</a>
    <a href="/blog" class:list={[{ active: isBlog }]}>blog</a>
    <a href="https://github.com/MoistCode" target="_blank" rel="noopener" class="social-text">github</a>
    <a href="https://www.linkedin.com/in/tommy-long-pham-4b7737158/" target="_blank" rel="noopener" class="social-text">linkedin</a>
    <a href="https://github.com/MoistCode" target="_blank" rel="noopener" aria-label="GitHub" class="social-icon">
      <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/tommy-long-pham-4b7737158/" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-icon">
      <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg-primary);
    z-index: 10;
    font-family: var(--font-mono);
  }
  .nav-left { display: flex; align-items: center; }
  .nav-home-link {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-avatar-small {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid rgba(34, 211, 238, 0.3);
    object-fit: cover;
    display: none;
  }
  .nav-name {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tilde { color: var(--accent); font-weight: 700; }
  .nav-name span { font-size: 14px; font-weight: 600; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 12px;
  }
  .nav-right a {
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .nav-right a:hover { color: var(--text-primary); }
  .nav-right a.active { color: var(--accent); }
  .social-icon {
    display: none;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .social-icon:hover { color: var(--text-primary); }

  @media (max-width: 640px) {
    .nav { padding: 12px 16px; }
    .nav-avatar-small { display: block; }
    .nav-name { display: none; }
    .nav-right { gap: 14px; }
    .social-text { display: none; }
    .social-icon { display: flex; align-items: center; }
  }
</style>